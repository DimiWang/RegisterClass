              <item row="4" column="0" colspan="3">
               <widget class="QPlainTextEdit" name="teCFileBitFieldOper">
                <property name="styleSheet">
                 <string notr="true">font: 8pt &quot;Consolas&quot;;</string>
                </property>
                <property name="lineWrapMode">
                 <enum>QPlainTextEdit::NoWrap</enum>
                </property>
                <property name="plainText">
                 <string notr="true">#define FIELD_MASK(MSB, LSB) (0xffffffff &gt;&gt; (32 - ((MSB) - (LSB) + 1)))
#define FIELD_VALUE(BASE, MSB, LSB) (*((uint32_t *)(BASE)) &gt;&gt; (LSB)&amp;FIELD_MASK((MSB), (LSB)))
#define FIELD_SET_VALUE(BASE, MSB, LSB, VAL)                                  \
    do                                                                        \
    {                                                                         \
        *((uint32_t *)(BASE)) &amp;= ~(FIELD_MASK((MSB), (LSB)) &lt;&lt; (LSB));        \
        *((uint32_t *)(BASE)) |= (FIELD_MASK((MSB), (LSB)) &amp; (VAL)) &lt;&lt; (LSB); \
    } while (0);
</string>
                </property>
               </widget>
